+        # Segment original text first. Normalized offsets cannot safely index
+        # original Unicode text, and a marker must never consume earlier clauses.
+        isolated_preambles = []
+        raw_sentences = []
+        for match in re.finditer(r"[^.;\n]+[.;]?", response_text):
+            segment = match.group().strip()
+            if not segment:
+                continue
+            normalized = _normalize_text(segment).strip(" .;")
+            marker = next((m for m in self.preamble_markers
