                            segment_by_id[segment_id].get("participant_id")
                            for evidence_id in evaluation["evidence_ids"]
                            for segment_id in evidence_by_id[evidence_id]["source"]["segment_ids"]
                            if segment_id in segment_by_id
                        ),
