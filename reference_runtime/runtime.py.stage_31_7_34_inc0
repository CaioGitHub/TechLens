    }
    report = {
        "report_id": _stable_id("REPORT", _fixture_id(fixture)),
        "fixture_id": _fixture_id(fixture),
        "candidate": next(
            (
                participant
                for participant in structured["participants"]
                if participant.get("role") == "candidate"
            ),
            None,
        ),
