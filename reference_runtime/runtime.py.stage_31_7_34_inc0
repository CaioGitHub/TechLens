) -> dict[str, Any]:
    q_norm = _normalize_text(question_text)
    r_norm = _normalize_text(response_text)
    r_stems = _extract_stemmed_tokens(response_text)

    split_markers = (
        " e como ",
        " e o que ",
        " e qual ",
        " e quais ",
        " e por que ",
